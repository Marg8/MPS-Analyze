# ── MPS Capacity Scheduler — environment template ────────────────────────────
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
# `.env` is git-ignored and must never be committed.

# ── Server ───────────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# ── Privacy / telemetry ──────────────────────────────────────────────────────
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── Upload limits (MB) — raise if users upload large workbooks ───────────────
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=50

# ── Performance ──────────────────────────────────────────────────────────────
# File watching is unnecessary in production; keep it off to save CPU.
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none

# ── (Optional) reverse-proxy / sub-path deployment ───────────────────────────
# STREAMLIT_SERVER_BASE_URL_PATH=mps
# STREAMLIT_SERVER_ENABLE_CORS=false
# STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
